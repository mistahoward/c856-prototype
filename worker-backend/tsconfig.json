{
	"compilerOptions": {
	  "target": "es2022",
	  "module": "NodeNext",
	  "lib": ["es2022"],
	  "outDir": "./dist",
	  "rootDir": "./src",
	  "moduleResolution": "NodeNext",
	  "resolveJsonModule": true,
	  "strict": true,
	  "noImplicitAny": false,
	  "esModuleInterop": true,
	  "forceConsistentCasingInFileNames": true,
	  "sourceMap": true,
	  "skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
  }
  